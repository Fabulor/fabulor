<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup Label="UserMacros">

		<!-- SPECIFY YOUR DEPENDENCY DIRECTORIES HERE -->

		<YourPython3Path>c:\gtk-build\python-3.14</YourPython3Path>

		<!-- YOU SHOULDN'T TOUCH ANYTHING BELOW -->

		<!-- Force x64 only -->
		<FabulorPlatform>x64</FabulorPlatform>
		<FabulorGtkMajor>4</FabulorGtkMajor>

		<!-- G_DISABLE_DEPRECATED is unfeasible due to g_completion_* -->
		<!-- must be buildable with GSEAL_ENABLE in the future, xtext, setup, and chanview-tabs stand in the way -->
		<OwnFlags>GTK_DISABLE_DEPRECATED;GDK_PIXBUF_DISABLE_DEPRECATED;G_DISABLE_SINGLE_INCLUDES;GDK_PIXBUF_DISABLE_SINGLE_INCLUDES;GTK_DISABLE_SINGLE_INCLUDES;HAVE_X509_GET_SIGNATURE_NID;HAVE_SSL_CTX_GET_SSL_METHOD;DEFAULT_CERT_FILE="cert.pem";HAVE_STRTOULL;strtoull=_strtoui64;strcasecmp=stricmp;strncasecmp=strnicmp;__inline__=__inline;FABULOR_GTK4_FRONTEND_MODULE</OwnFlags>

		<!-- FIXME: Add ability to use debug builds -->
		<FabulorGtk4Root Condition="'$(FabulorGtk4Root)'=='' and '$(FABULOR_GTK4_ROOT)'!=''">$(FABULOR_GTK4_ROOT)</FabulorGtk4Root>
		<FabulorGtk4Root Condition="'$(FabulorGtk4Root)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Runtime\GTK4'))</FabulorGtk4Root>
		<FabulorSupportDepsRoot Condition="'$(FabulorSupportDepsRoot)'=='' and '$(FABULOR_SUPPORT_DEPS_ROOT)'!=''">$(FABULOR_SUPPORT_DEPS_ROOT)</FabulorSupportDepsRoot>
		<FabulorSupportDepsRoot Condition="'$(FabulorSupportDepsRoot)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\build\vcpkg-installed\x64-windows'))</FabulorSupportDepsRoot>
		<DepsRoot>$(FabulorGtk4Root)</DepsRoot>
		<GtkDepsRoot>$(FabulorGtk4Root)</GtkDepsRoot>
		<Python3Path>$(YourPython3Path)\$(FabulorPlatform)</Python3Path>
		<Python3Lib>python314</Python3Lib>
		<Python3Output>hcpython3</Python3Output>
		<Python3Enabled Condition="Exists('$(Python3Path)\\python.exe') and Exists('$(Python3Path)\\libs\\$(Python3Lib).lib') and Exists('$(Python3Path)\\Lib\\site-packages\\cffi')">true</Python3Enabled>
		<Python3Enabled Condition="'$(Python3Enabled)'==''">false</Python3Enabled>

		<GlibGenMarshal Condition="Exists('$(DepsRoot)\bin\glib-genmarshal.exe')">"$(DepsRoot)\bin\glib-genmarshal.exe"</GlibGenMarshal>
		<GlibGenMarshal Condition="'$(GlibGenMarshal)'=='' and Exists('$(DepsRoot)\bin\glib-genmarshal') and Exists('$(Python3Path)\python.exe')">"$(Python3Path)\python.exe" "$(DepsRoot)\bin\glib-genmarshal"</GlibGenMarshal>

		<Glib>$(GtkDepsRoot)\include\glib-2.0;$(GtkDepsRoot)\lib\glib-2.0\include;$(DepsRoot)\include\libxml2</Glib>

		<Gtk4>$(GtkDepsRoot)\include;$(GtkDepsRoot)\include\gtk-4.0;$(GtkDepsRoot)\include\graphene-1.0;$(GtkDepsRoot)\lib\graphene-1.0\include</Gtk4>
		<GtkCommon>$(GtkDepsRoot)\include\cairo;$(GtkDepsRoot)\include\pango-1.0;$(GtkDepsRoot)\include\gdk-pixbuf-2.0;$(GtkDepsRoot)\include\harfbuzz</GtkCommon>
		<Gtk>$(Gtk4);$(GtkCommon)</Gtk>
		<GlibCompileResources Condition="Exists('$(GtkDepsRoot)\bin\glib-compile-resources.exe')">$(GtkDepsRoot)\bin\glib-compile-resources.exe</GlibCompileResources>

		<OpenSslLibs>libssl.lib;libcrypto.lib</OpenSslLibs>
		<OpenSslInclude>$(FabulorSupportDepsRoot)\include</OpenSslInclude>

		<!-- Resolve library names across dependency bundles -->
		<IntlLib Condition="Exists('$(DepsRoot)\lib\intl.lib')">intl.lib</IntlLib>
		<IntlLib Condition="'$(IntlLib)'=='' and Exists('$(DepsRoot)\lib\libintl.lib')">libintl.lib</IntlLib>

		<IconvLib Condition="Exists('$(DepsRoot)\lib\iconv.lib')">iconv.lib</IconvLib>
		<IconvLib Condition="'$(IconvLib)'=='' and Exists('$(DepsRoot)\lib\libiconv.lib')">libiconv.lib</IconvLib>

		<ZlibLib Condition="Exists('$(DepsRoot)\lib\zlib1.lib')">zlib1.lib</ZlibLib>
		<ZlibLib Condition="'$(ZlibLib)'=='' and Exists('$(DepsRoot)\lib\zlib.lib')">zlib.lib</ZlibLib>

		<Xml2Lib Condition="Exists('$(DepsRoot)\lib\libxml2.lib')">libxml2.lib</Xml2Lib>
		<Xml2Lib Condition="'$(Xml2Lib)'=='' and Exists('$(DepsRoot)\lib\xml2.lib')">xml2.lib</Xml2Lib>
		<Xml2Lib Condition="'$(Xml2Lib)'=='' and Exists('$(DepsRoot)\lib\libxml2-2.lib')">libxml2-2.lib</Xml2Lib>

		<JpegLib Condition="Exists('$(DepsRoot)\lib\jpeg.lib')">jpeg.lib</JpegLib>
		<JpegLib Condition="'$(JpegLib)'=='' and Exists('$(DepsRoot)\lib\libjpeg.lib')">libjpeg.lib</JpegLib>
		<JpegLib Condition="'$(JpegLib)'=='' and Exists('$(DepsRoot)\lib\libjpeg-8.lib')">libjpeg-8.lib</JpegLib>
		<JpegLib Condition="'$(JpegLib)'=='' and Exists('$(DepsRoot)\lib\libjpeg-9.lib')">libjpeg-9.lib</JpegLib>

		<PngLib Condition="Exists('$(DepsRoot)\lib\libpng16.lib')">libpng16.lib</PngLib>
		<PngLib Condition="'$(PngLib)'=='' and Exists('$(DepsRoot)\lib\libpng16_static.lib')">libpng16_static.lib</PngLib>
		<PngLib Condition="'$(PngLib)'=='' and Exists('$(DepsRoot)\lib\libpng.lib')">libpng.lib</PngLib>

		<DepLibs>gtk-4.lib;wininet.lib;winmm.lib;ws2_32.lib;advapi32.lib;gio-2.0.lib;gdk_pixbuf-2.0.lib;pangowin32-1.0.lib;pangocairo-1.0.lib;pango-1.0.lib;cairo.lib;graphene-1.0.lib;gobject-2.0.lib;gmodule-2.0.lib;glib-2.0.lib;intl.lib;$(IconvLib);$(ZlibLib);$(Xml2Lib);$(JpegLib);$(PngLib);$(OpenSslLibs)</DepLibs>

		<DataDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\data\'))</DataDir>
		<FabulorBuild Condition="'$(FabulorBuild)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\build\gtk4-full'))</FabulorBuild>
		<FabulorBin>$(FabulorBuild)\$(FabulorPlatform)\bin\</FabulorBin>
		<FabulorObj>$(FabulorBuild)\$(FabulorPlatform)\obj\</FabulorObj>
		<FabulorLib>$(FabulorBuild)\$(FabulorPlatform)\lib\</FabulorLib>
		<FabulorPdb>$(FabulorBuild)\$(FabulorPlatform)\pdb\</FabulorPdb>
		<FabulorRel>$(FabulorBuild)\$(FabulorPlatform)\rel\</FabulorRel>

	</PropertyGroup>

	<!-- If someone tries Win32, stop immediately. -->
	<PropertyGroup>
		<_FabulorPlatformMismatch Condition="'$(Platform)'!='x64' and '$(PlatformName)'!='x64'">true</_FabulorPlatformMismatch>
	</PropertyGroup>
	<Target Name="FabulorPropsEnforceX64" BeforeTargets="PrepareForBuild" Condition="'$(_FabulorPlatformMismatch)'=='true'">
		<Error Text="fabulor.props is configured for x64 only. Set the Solution/Project Platform to x64." />
	</Target>
	<Target Name="FabulorValidateGtkProfile" BeforeTargets="PrepareForBuild">
		<Error Condition="'$(FabulorGtkMajor)'!='4'" Text="Fabulor supports only the GTK4 frontend build profile." />
		<Error Condition="!Exists('$(FabulorGtk4Root)\include\gtk-4.0\gtk\gtk.h')" Text="The GTK4 build profile requires a development root at FabulorGtk4Root ($(FabulorGtk4Root))." />
		<Error Condition="!Exists('$(GlibCompileResources)')" Text="The GTK4 build profile requires glib-compile-resources.exe beneath FabulorGtk4Root." />
		<Error Condition="!Exists('$(FabulorSupportDepsRoot)\include\openssl\ssl.h')" Text="The GTK4 build profile requires OpenSSL headers at FabulorSupportDepsRoot ($(FabulorSupportDepsRoot))." />
		<Error Condition="!Exists('$(FabulorSupportDepsRoot)\lib\libssl.lib') or !Exists('$(FabulorSupportDepsRoot)\lib\libcrypto.lib')" Text="The GTK4 build profile requires OpenSSL import libraries at FabulorSupportDepsRoot ($(FabulorSupportDepsRoot))." />
	</Target>

	<PropertyGroup>
		<LinkIncremental>false</LinkIncremental>
		<IntDir>$(FabulorObj)$(ProjectName)\</IntDir>
		<UseDebugLibraries>false</UseDebugLibraries>
		<WholeProgramOptimization>true</WholeProgramOptimization>
		<CharacterSet>MultiByte</CharacterSet>
	</PropertyGroup>

	<ItemDefinitionGroup>
		<ClCompile>
			<WarningLevel>Level3</WarningLevel>
			<PrecompiledHeader>NotUsing</PrecompiledHeader>
			<DisableSpecificWarnings>4996</DisableSpecificWarnings>
			<BasicRuntimeChecks>Default</BasicRuntimeChecks>
			<SmallerTypeCheck>false</SmallerTypeCheck>
			<AdditionalOptions>/d2Zi+ %(AdditionalOptions)</AdditionalOptions>
			<WholeProgramOptimization>false</WholeProgramOptimization>
			<!-- UNCOMMENT ONLY ONE -->
			<!--<Optimization>Disabled</Optimization>-->
			<!--Optimization>MaxSpeed</Optimization-->
			<!--Optimization>MinSpace</Optimization-->
			<Optimization>Full</Optimization>
			<FunctionLevelLinking>true</FunctionLevelLinking>
			<IntrinsicFunctions>true</IntrinsicFunctions>
			<MultiProcessorCompilation>true</MultiProcessorCompilation>
			<PreProcessorDefinitions>NTDDI_VERSION=NTDDI_WIN8;_WIN32_WINNT=_WIN32_WINNT_WIN8;%(PreProcessorDefinitions)</PreProcessorDefinitions>
		</ClCompile>
		<Lib>
			<LinkTimeCodeGeneration>false</LinkTimeCodeGeneration>
		</Lib>
		<Link>
			<AdditionalLibraryDirectories>$(FabulorSupportDepsRoot)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
			<ImportLibrary>$(FabulorLib)$(TargetName).lib</ImportLibrary>
			<ProgramDatabaseFile>$(FabulorPdb)$(TargetName).pdb</ProgramDatabaseFile>
			<SubSystem>Windows</SubSystem>
			<GenerateDebugInformation>Debug</GenerateDebugInformation>
			<EnableCOMDATFolding>true</EnableCOMDATFolding>
			<OptimizeReferences>true</OptimizeReferences>
			<LinkTimeCodeGeneration>Default</LinkTimeCodeGeneration>
		</Link>
	</ItemDefinitionGroup>

	<ItemGroup />
</Project>
