diff --git a/testsuite/gdk/win32-fractional-scale.c b/testsuite/gdk/win32-fractional-scale.c
new file mode 100644
--- /dev/null
+++ b/testsuite/gdk/win32-fractional-scale.c
@@ -0,0 +1,92 @@
+#include <float.h>
+#include <math.h>
+
+#ifdef G_DISABLE_ASSERT
+#undef G_DISABLE_ASSERT
+#endif
+
+#include "../../gdk/win32/gdkdisplay-win32.h"
+
+static const guint test_dpis[] = {
+  96, 120, 144, 168, 192, 216, 240, 288
+};
+
+static const double logical_coordinates[] = {
+  0.0, 1.0, 17.0, 145.0, 150.0, 256.0, 801.0, 1920.0
+};
+
+static void
+test_dpi_scales (void)
+{
+  guint i;
+
+  for (i = 0; i < G_N_ELEMENTS (test_dpis); i++)
+    g_assert_cmpfloat_with_epsilon (gdk_win32_dpi_to_scale (test_dpis[i]),
+                                    test_dpis[i] / 96.0,
+                                    DBL_EPSILON);
+}
+
+static void
+test_coordinate_round_trips (void)
+{
+  guint i, j;
+
+  for (i = 0; i < G_N_ELEMENTS (test_dpis); i++)
+    {
+      double scale = gdk_win32_dpi_to_scale (test_dpis[i]);
+
+      for (j = 0; j < G_N_ELEMENTS (logical_coordinates); j++)
+        {
+          double logical = logical_coordinates[j];
+          int physical = gdk_win32_logical_to_physical (logical, scale);
+          double recovered = gdk_win32_physical_to_logical (physical, scale);
+
+          g_assert_cmpfloat (fabs (recovered - logical), <=,
+                             0.5 / scale + DBL_EPSILON * logical);
+        }
+    }
+}
+
+static void
+test_repeated_scale_transitions (void)
+{
+  const double saved_logical_width = 150.0;
+  guint pass, i;
+
+  for (pass = 0; pass < 25; pass++)
+    {
+      for (i = 0; i < G_N_ELEMENTS (test_dpis); i++)
+        {
+          double scale = gdk_win32_dpi_to_scale (test_dpis[i]);
+          int physical = gdk_win32_logical_to_physical (saved_logical_width,
+                                                         scale);
+          double recovered = gdk_win32_physical_to_logical (physical, scale);
+
+          g_assert_cmpfloat (fabs (recovered - saved_logical_width), <=,
+                             0.5 / scale + DBL_EPSILON * saved_logical_width);
+        }
+
+      for (i = G_N_ELEMENTS (test_dpis); i-- > 0; )
+        {
+          double scale = gdk_win32_dpi_to_scale (test_dpis[i]);
+          int physical = gdk_win32_logical_to_physical (saved_logical_width,
+                                                         scale);
+          double recovered = gdk_win32_physical_to_logical (physical, scale);
+
+          g_assert_cmpfloat (fabs (recovered - saved_logical_width), <=,
+                             0.5 / scale + DBL_EPSILON * saved_logical_width);
+        }
+    }
+
+  g_assert_cmpfloat (saved_logical_width, ==, 150.0);
+}
+
+int
+main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/win32/fractional-scale/dpi", test_dpi_scales);
+  g_test_add_func ("/win32/fractional-scale/coordinates", test_coordinate_round_trips);
+  g_test_add_func ("/win32/fractional-scale/transitions", test_repeated_scale_transitions);
+  return g_test_run ();
+}
