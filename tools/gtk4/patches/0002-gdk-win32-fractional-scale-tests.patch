diff --git a/gdk/win32/gdkdisplay-win32.c b/gdk/win32/gdkdisplay-win32.c
--- a/gdk/win32/gdkdisplay-win32.c
+++ b/gdk/win32/gdkdisplay-win32.c
@@ -1241,6 +1241,28 @@ gdk_win32_display_get_monitors (GdkDisplay *display)
   return self->monitors;
 }
 
+double
+gdk_win32_dpi_to_scale (guint dpi)
+{
+  return MAX ((double) dpi / USER_DEFAULT_SCREEN_DPI, 1.0);
+}
+
+double
+gdk_win32_physical_to_logical (double coordinate,
+                               double scale)
+{
+  g_return_val_if_fail (scale > 0.0, coordinate);
+  return coordinate / scale;
+}
+
+int
+gdk_win32_logical_to_physical (double coordinate,
+                               double scale)
+{
+  g_return_val_if_fail (scale > 0.0, (int) lround (coordinate));
+  return (int) lround (coordinate * scale);
+}
+
