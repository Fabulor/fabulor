@@ -1263,6 +1263,31 @@ gdk_win32_logical_to_physical (double coordinate,
   return (int) lround (coordinate * scale);
 }
 
+void
+gdk_win32_physical_rect_to_logical (long          left,
+                                    long          top,
+                                    long          right,
+                                    long          bottom,
+                                    double        scale,
+                                    GdkRectangle *rect)
+{
+  int logical_left;
+  int logical_top;
+  int logical_right;
+  int logical_bottom;
+
+  g_return_if_fail (scale > 0.0);
+  g_return_if_fail (rect != NULL);
+
+  logical_left = floor (left / scale);
+  logical_top = floor (top / scale);
+  logical_right = ceil (right / scale);
+  logical_bottom = ceil (bottom / scale);
+  *rect = (GdkRectangle) { logical_left, logical_top,
+                          logical_right - logical_left,
+                          logical_bottom - logical_top };
+}
