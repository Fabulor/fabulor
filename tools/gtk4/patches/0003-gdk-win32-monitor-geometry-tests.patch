 static void
+test_monitor_rectangles (void)
+{
+  GdkRectangle rect;
+
+  gdk_win32_physical_rect_to_logical (-3840, 0, -1920, 2160, 2.5, &rect);
+  g_assert_cmpint (rect.x, ==, -1536);
+  g_assert_cmpint (rect.y, ==, 0);
+  g_assert_cmpint (rect.width, ==, 768);
+  g_assert_cmpint (rect.height, ==, 864);
+
+  gdk_win32_physical_rect_to_logical (-1919, -1079, -1, -1, 1.25, &rect);
+  g_assert_cmpint (rect.x, ==, -1536);
+  g_assert_cmpint (rect.y, ==, -864);
+  g_assert_cmpint (rect.width, ==, 1536);
+  g_assert_cmpint (rect.height, ==, 864);
+
+  gdk_win32_physical_rect_to_logical (1, 1, 1919, 1079, 1.75, &rect);
+  g_assert_cmpint (rect.x, ==, 0);
+  g_assert_cmpint (rect.y, ==, 0);
+  g_assert_cmpint (rect.width, ==, 1097);
+  g_assert_cmpint (rect.height, ==, 617);
+}
