<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
    <Platform Condition="'$(Platform)'==''">x64</Platform>
    <FabulorGtk4Root Condition="'$(FabulorGtk4Root)'=='' and '$(FABULOR_GTK4_ROOT)'!=''">$(FABULOR_GTK4_ROOT)</FabulorGtk4Root>
    <FabulorGtk4Root Condition="'$(FabulorGtk4Root)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\Runtime\GTK4'))</FabulorGtk4Root>
    <FabulorSupportDepsRoot Condition="'$(FabulorSupportDepsRoot)'=='' and '$(FABULOR_SUPPORT_DEPS_ROOT)'!=''">$(FABULOR_SUPPORT_DEPS_ROOT)</FabulorSupportDepsRoot>
    <BuildProperties>Configuration=$(Configuration);Platform=$(Platform);FabulorGtkMajor=4;FabulorGtk4Root=$(FabulorGtk4Root);FabulorSupportDepsRoot=$(FabulorSupportDepsRoot)</BuildProperties>
  </PropertyGroup>

  <ItemGroup>
    <NativeExtensionProject Include="$(MSBuildThisFileDirectory)..\..\plugins\checksum\checksum.vcxproj" />
    <NativeExtensionProject Include="$(MSBuildThisFileDirectory)..\..\plugins\exec\exec.vcxproj" />
    <NativeExtensionProject Include="$(MSBuildThisFileDirectory)..\..\plugins\fishlim\fishlim.vcxproj" />
    <NativeExtensionProject Include="$(MSBuildThisFileDirectory)..\..\plugins\python\python3.vcxproj" />
    <NativeExtensionProject Include="$(MSBuildThisFileDirectory)..\..\plugins\sysinfo\sysinfo.vcxproj" />
    <NativeExtensionProject Include="$(MSBuildThisFileDirectory)..\..\src\fe-gtk\notifications\notifications-winrt.vcxproj" />
  </ItemGroup>

  <Target Name="ValidateInputs">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\..\build\gtk4-full\$(Platform)\lib\common.lib')"
           Text="Missing isolated GTK4 common.lib. Build gtk4-full-frontend.proj first." />
  </Target>

  <Target Name="Build" DependsOnTargets="ValidateInputs">
    <Message Importance="high" Text="Building isolated GTK4 native extensions against $(FabulorGtk4Root)" />
    <MSBuild Projects="@(NativeExtensionProject)" Targets="Build"
             Properties="$(BuildProperties)" BuildInParallel="false" />
  </Target>

  <Target Name="Clean">
    <MSBuild Projects="@(NativeExtensionProject)" Targets="Clean"
             Properties="$(BuildProperties)" BuildInParallel="false" />
  </Target>
</Project>
