{
    "projectName": "Fabulor Modernisation",
    "description": "Windows-only modernisation of the legacy IRC client, with installer\\ as the primary long-term installer surface and To-Do.md as the roadmap for plugin and runtime rework.",
    "languages": [
        "c",
        "cpp",
        "csharp",
        "python",
        "tcl",
        "json",
        "xml",
        "xaml",
        "ini",
        "powershell"
    ],
    "workspace": {
        "root": ".",
        "sourceDirectories": [
            "installer",
            "src",
            "plugins",
            "docs",
            "prompts",
            "win32",
            ".github/workflows"
        ],
        "buildDirectories": [
            "installer/bin",
            "installer/obj",
            "installer/Bootstrapper/bin",
            "installer/Bootstrapper/obj",
            "installer/UX/bin",
            "installer/UX/obj"
        ],
        "scriptDirectories": [
            "installer",
            "win32",
            ".github/workflows"
        ]
    },
    "ignore": [
        ".git/",
        ".vs/",
        ".vscode/",
        "node_modules/",
        "installer/bin/",
        "installer/obj/",
        "installer/Bootstrapper/bin/",
        "installer/Bootstrapper/obj/",
        "installer/UX/bin/",
        "installer/UX/obj/"
    ],
    "analysis": {
        "deepCodeAnalysis": true,
        "dependencyGraph": true,
        "buildSystemMapping": true,
        "pluginMapping": true,
        "detectLegacyScripts": true,
        "detectHardcodedPaths": true,
        "detectWindowsSpecificCode": true
    },
    "goals": [
        "Treat installer\\ as the primary installer surface",
        "Use To-Do.md as the roadmap for plugin modernisation",
        "Map the current WiX v4 installer and bootstrapper architecture",
        "Identify legacy win32\\ surfaces that still feed the installer payload",
        "Track plugin migration work across built-in C plugins and planned C#/Python/Tcl support",
        "Locate Windows-specific runtime and packaging assumptions"
    ],
    "workspaceHints": {
        "c": {
            "includeDirectories": [
                "src",
                "src/common",
                "win32"
            ],
            "defines": [
                "WIN32",
                "_WINDOWS",
                "_CRT_SECURE_NO_WARNINGS"
            ]
        },
        "primaryRoadmap": "To-Do.md",
        "primaryPromptManifest": "prompts/manifest.json"
    }
}
