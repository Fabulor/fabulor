  <ItemDefinitionGroup>
    <PreBuildEvent>
      <Command><![CDATA[
SET "SOLUTIONDIR=$(MSBuildThisFileDirectory)..\..\"
IF NOT EXIST "$(MSBuildThisFileDirectory)..\..\win32\version-template.ps1" (
  ECHO Missing version template script: $(MSBuildThisFileDirectory)..\..\win32\version-template.ps1
  EXIT /B 1
)
"$(Python3Path)\python.exe" $(ProjectDir)make-te.py "$(ProjectDir)textevents.in" "$(FabulorLib)textevents.h" "$(FabulorLib)textenums.h"
IF ERRORLEVEL 1 EXIT /B 1
"$(Python3Path)\python.exe" $(ProjectDir)gen-public-suffix.py "$(FabulorLib)public_suffix_data.h"
IF ERRORLEVEL 1 EXIT /B 1
powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildThisFileDirectory)..\..\win32\version-template.ps1" "$(MSBuildThisFileDirectory)..\..\win32\config.h.tt" "$(FabulorLib)config.h"
IF ERRORLEVEL 1 EXIT /B 1
IF NOT EXIST "$(FabulorLib)config.h" (
  ECHO Failed to generate $(FabulorLib)config.h
  EXIT /B 1
)
FOR %%I IN ("$(FabulorLib)config.h") DO IF %%~zI EQU 0 (
  ECHO Generated configuration header is empty: $(FabulorLib)config.h
  EXIT /B 1
)
$(GlibGenMarshal) --prefix=_fabulor_marshal --header "$(ProjectDir)marshalers.list" --output "$(FabulorLib)marshal.h"
IF ERRORLEVEL 1 EXIT /B 1
$(GlibGenMarshal) --prefix=_fabulor_marshal --body "$(ProjectDir)marshalers.list" --output "$(FabulorLib)marshal.c"
IF ERRORLEVEL 1 EXIT /B 1
      ]]></Command>
