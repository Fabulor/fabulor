#include <winver.h>
#include "config.h"

#define COMMA_VERSION <#= [string]::Join(',', ($versionParts | %{ ($_ -split '[^0-9]')[0] })) #>,0
#define VERSION_STRING "<#= [string]::Join('.', ($versionParts | %{ ($_ -split '[^0-9]')[0] })) #>"

XC_ICON ICON "<#= $env:SOLUTIONDIR -replace '\\', '/' #>data/icons/fabulor.ico"

VS_VERSION_INFO VERSIONINFO
	FILEVERSION    COMMA_VERSION
	PRODUCTVERSION COMMA_VERSION
	BEGIN
		BLOCK "StringFileInfo"
		BEGIN
			BLOCK "040904B0"
			BEGIN
				VALUE "FileDescription", "Fabulor GTK4 Frontend"
				VALUE "CompanyName", "Fabulor"
				VALUE "InternalName", "fabulor-gtk4-frontend"
				VALUE "OriginalFilename", "fabulor-gtk4-frontend.dll"
				VALUE "ProductName", "Fabulor"
				VALUE "LegalCopyright", "Copyright (C) 2025-2026 Fabulor contributors"
				VALUE "ProductVersion", VERSION_STRING
				VALUE "FileVersion", VERSION_STRING
			END
		END
		BLOCK "VarFileInfo"
		BEGIN
			VALUE "Translation", 0x0409, 0x04B0
		END
	END
