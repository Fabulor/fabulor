<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="WixToolset.Sdk/7.0.0">

  <PropertyGroup>
    <Platform>x64</Platform>
    <AcceptEula>wix7</AcceptEula>

    <WixToolsetMajorVersion>7</WixToolsetMajorVersion>
    <WixToolsetVersion>7.0.0</WixToolsetVersion>
    <FabulorPayloadRoot Condition="'$(FabulorPayloadRoot)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\build\gtk4-production-support\'))</FabulorPayloadRoot>
    <GtkRuntimeRoot Condition="'$(GtkRuntimeRoot)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\build\gtk4-runtime-production-root\Runtime\GTK4\'))</GtkRuntimeRoot>
    <Gtk4FrontendRoot Condition="'$(Gtk4FrontendRoot)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\build\gtk4-full\$(Platform)\rel\'))</Gtk4FrontendRoot>
    <Gtk4LocaleRoot Condition="'$(Gtk4LocaleRoot)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\build\gtk4-full\$(Platform)\bin\locale\'))</Gtk4LocaleRoot>
    <Gtk4EnchantRoot Condition="'$(Gtk4EnchantRoot)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\build\gtk4-enchant-stage\'))</Gtk4EnchantRoot>
    <Gtk4PluginHostRoot Condition="'$(Gtk4PluginHostRoot)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\build\gtk4-plugin-host-production-root\'))</Gtk4PluginHostRoot>
    <ManagedPluginHostBuildRoot Condition="'$(ManagedPluginHostBuildRoot)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\src\managed\Fabulor.PluginHost\bin\$(Platform)\$(Configuration)\net8.0\'))</ManagedPluginHostBuildRoot>
    <FabulorLegalRoot Condition="'$(FabulorLegalRoot)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\build\release-legal\'))</FabulorLegalRoot>
    <BuildFabulorBootstrapper Condition="'$(BuildFabulorBootstrapper)'==''">true</BuildFabulorBootstrapper>
    <OutputPath Condition="'$(FabulorInstallerOutputPath)'!=''">$(FabulorInstallerOutputPath)</OutputPath>
    <IntermediateOutputPath Condition="'$(FabulorInstallerIntermediateOutputPath)'!=''">$(FabulorInstallerIntermediateOutputPath)</IntermediateOutputPath>
    <BundledDotNetRuntimeVersion Condition="'$(BundledDotNetRuntimeVersion)'==''">8.0.29</BundledDotNetRuntimeVersion>
    <PythonRuntimeFolderName>Python314</PythonRuntimeFolderName>
    <DefineConstants>$(DefineConstants);FabulorProductName=$(FabulorProductName);FabulorPublisher=$(FabulorPublisher);FabulorSemVer=$(FabulorSemVer);FabulorPayloadRoot=$(FabulorPayloadRoot);GtkRuntimeRoot=$(GtkRuntimeRoot);Gtk4FrontendRoot=$(Gtk4FrontendRoot);Gtk4LocaleRoot=$(Gtk4LocaleRoot);Gtk4EnchantRoot=$(Gtk4EnchantRoot);Gtk4PluginHostRoot=$(Gtk4PluginHostRoot);ManagedPluginHostBuildRoot=$(ManagedPluginHostBuildRoot);FabulorLegalRoot=$(FabulorLegalRoot);BundledDotNetRuntimeVersion=$(BundledDotNetRuntimeVersion);PythonRuntimeFolderName=$(PythonRuntimeFolderName)</DefineConstants>

    <WixProjectType>Package</WixProjectType>
    <OutputName Condition="'$(FabulorInstallerOutputName)'==''">Fabulor</OutputName>
    <OutputName Condition="'$(FabulorInstallerOutputName)'!=''">$(FabulorInstallerOutputName)</OutputName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SuppressIces>ICE60;ICE61</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ProductGtk4.wxs" />
    <Compile Include="Components\Config.wxs;Components\CoreGtk4.wxs;Components\EnchantGtk4.wxs;Components\GTK4Allowlist.wxs;Components\InstalledMode.wxs;Components\Legal.wxs;Components\PluginsGtk4.wxs;Components\PluginRuntimesGtk4.wxs;Components\PortableMode.wxs;Components\ShareAssets.wxs;Components\ShareGtk4.wxs" />
  </ItemGroup>

  <Target Name="BuildManagedPluginHost" BeforeTargets="Compile">
    <MSBuild Projects="..\src\managed\Fabulor.PluginHost\Fabulor.PluginHost.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform)" />
    <ItemGroup>
      <ManagedPluginHostOutput Include="$(ManagedPluginHostBuildRoot)\Fabulor.PluginAbstractions.dll" />
      <ManagedPluginHostOutput Include="$(ManagedPluginHostBuildRoot)\Fabulor.PluginHost.deps.json" />
      <ManagedPluginHostOutput Include="$(ManagedPluginHostBuildRoot)\Fabulor.PluginHost.dll" />
      <ManagedPluginHostOutput Include="$(ManagedPluginHostBuildRoot)\Fabulor.PluginHost.runtimeconfig.json" />
    </ItemGroup>
    <Error Condition="!Exists('%(ManagedPluginHostOutput.Identity)')" Text="Missing rebuilt managed plugin-host file %(ManagedPluginHostOutput.Identity)." />
    <MakeDir Directories="$(Gtk4PluginHostRoot)\Runtime\DotNet" />
    <Copy SourceFiles="@(ManagedPluginHostOutput)"
          DestinationFolder="$(Gtk4PluginHostRoot)\Runtime\DotNet"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ValidateInstallerPayload" BeforeTargets="Build" DependsOnTargets="BuildManagedPluginHost">
    <Error Condition="!Exists('$(FabulorPayloadRoot)\production-support-manifest.json')" Text="Missing allowlisted production-support manifest at $(FabulorPayloadRoot)." />
    <Error Condition="!Exists('$(Gtk4FrontendRoot)\fabulor.exe')" Text="Missing GTK4 launcher at $(Gtk4FrontendRoot). Build tools\gtk4\gtk4-full-frontend.proj first." />
    <Error Condition="!Exists('$(Gtk4FrontendRoot)\fabulor-gtk4-frontend.dll')" Text="Missing GTK4 frontend module at $(Gtk4FrontendRoot). Build tools\gtk4\gtk4-full-frontend.proj first." />
    <Error Condition="!Exists('$(Gtk4LocaleRoot)')" Text="Missing compiled Fabulor translations at $(Gtk4LocaleRoot)." />
    <Error Condition="Exists('$(Gtk4LocaleRoot)') and !Exists('$(Gtk4LocaleRoot)\de\LC_MESSAGES\fabulor.mo')" Text="Missing compiled Fabulor translation catalog beneath $(Gtk4LocaleRoot)." />
    <Error Condition="!Exists('$(FabulorPayloadRoot)\cert.pem')" Text="Missing GTK4 certificate bundle at $(FabulorPayloadRoot)." />
    <Error Condition="!Exists('$(FabulorPayloadRoot)\libssl-3-x64.dll')" Text="Missing GTK4 OpenSSL runtime at $(FabulorPayloadRoot)." />
    <Error Condition="!Exists('$(FabulorPayloadRoot)\libcrypto-3-x64.dll')" Text="Missing GTK4 OpenSSL crypto runtime at $(FabulorPayloadRoot)." />
    <Error Condition="!Exists('$(Gtk4FrontendRoot)\plugins\hcchecksum.dll')" Text="Missing GTK4 native extensions at $(Gtk4FrontendRoot)\plugins." />
    <Error Condition="!Exists('$(Gtk4FrontendRoot)\plugins\hcexec.dll')" Text="Missing GTK4 Exec extension at $(Gtk4FrontendRoot)\plugins." />
    <Error Condition="!Exists('$(Gtk4FrontendRoot)\plugins\hcfishlim.dll')" Text="Missing GTK4 FiSHLiM extension at $(Gtk4FrontendRoot)\plugins." />
    <Error Condition="!Exists('$(Gtk4FrontendRoot)\plugins\hcnotifications-winrt.dll')" Text="Missing GTK4 notification extension at $(Gtk4FrontendRoot)\plugins." />
    <Error Condition="!Exists('$(Gtk4FrontendRoot)\plugins\hcsysinfo.dll')" Text="Missing GTK4 Sysinfo extension at $(Gtk4FrontendRoot)\plugins." />
    <Error Condition="!Exists('$(Gtk4FrontendRoot)\plugins\hcpython3.dll')" Text="Missing GTK4 Python host extension at $(Gtk4FrontendRoot)\plugins." />
    <Error Condition="!Exists('$(Gtk4EnchantRoot)\libenchant-2-2.dll')" Text="Missing GTK4-compatible Enchant core at $(Gtk4EnchantRoot)." />
    <Error Condition="!Exists('$(Gtk4EnchantRoot)\lib\enchant-2\enchant_winspell.dll')" Text="Missing GTK4-compatible WinSpell provider at $(Gtk4EnchantRoot)." />
    <Error Condition="!Exists('$(Gtk4EnchantRoot)\share\enchant-2\enchant.ordering')" Text="Missing GTK4-compatible Enchant provider ordering at $(Gtk4EnchantRoot)." />
    <Error Condition="!Exists('$(Gtk4PluginHostRoot)\Runtime\plugin-host-manifest.json')" Text="Missing staged GTK4 plugin-host manifest at $(Gtk4PluginHostRoot)." />
    <Error Condition="!Exists('$(Gtk4PluginHostRoot)\Runtime\Python314\python314.dll')" Text="Missing staged Python 3.14 runtime at $(Gtk4PluginHostRoot)." />
    <Error Condition="!Exists('$(Gtk4PluginHostRoot)\Runtime\Tcl\bin\tcl86t.dll')" Text="Missing staged Tcl 8.6 runtime at $(Gtk4PluginHostRoot)." />
    <Error Condition="!Exists('$(Gtk4PluginHostRoot)\Runtime\DotNet\Fabulor.PluginAbstractions.dll')" Text="Missing staged managed plugin abstractions at $(Gtk4PluginHostRoot)." />
    <Error Condition="!Exists('$(Gtk4PluginHostRoot)\Runtime\DotNet\Fabulor.PluginHost.dll')" Text="Missing staged managed plugin host at $(Gtk4PluginHostRoot)." />
    <Error Condition="!Exists('$(Gtk4PluginHostRoot)\Runtime\DotNet\Fabulor.PluginHost.runtimeconfig.json')" Text="Missing staged managed plugin host at $(Gtk4PluginHostRoot)." />
    <Error Condition="!Exists('$(Gtk4PluginHostRoot)\Runtime\DotNet\host\fxr\$(BundledDotNetRuntimeVersion)\hostfxr.dll')" Text="Missing staged .NET hostfxr $(BundledDotNetRuntimeVersion) at $(Gtk4PluginHostRoot)." />
    <Error Condition="!Exists('$(Gtk4PluginHostRoot)\Runtime\DotNet\shared\Microsoft.NETCore.App\$(BundledDotNetRuntimeVersion)\hostpolicy.dll')" Text="Missing staged .NET shared runtime $(BundledDotNetRuntimeVersion) at $(Gtk4PluginHostRoot)." />
    <Error Condition="!Exists('$(GtkRuntimeRoot)\bin\gtk-4-1.dll')" Text="Missing GTK4 runtime payload at $(GtkRuntimeRoot)." />
    <Error Condition="!Exists('$(GtkRuntimeRoot)\runtime-manifest.json')" Text="Missing generated GTK4 runtime manifest at $(GtkRuntimeRoot). Stage the allowlisted runtime with tools\gtk4\stage_runtime.py before building WiX output." />
    <Error Condition="!Exists('$(FabulorLegalRoot)\THIRD-PARTY-NOTICES.md')" Text="Missing generated third-party notices at $(FabulorLegalRoot)." />
    <Error Condition="!Exists('$(FabulorLegalRoot)\Fabulor-$(FabulorSemVer).cdx.json')" Text="Missing generated CycloneDX SBOM at $(FabulorLegalRoot)." />
  </Target>

  <Target Name="BuildBootstrapper" AfterTargets="Build"
          Condition="'$(BuildFabulorBootstrapper)'=='true'">
    <MSBuild Projects="Bootstrapper\FabulorSetup.wixproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform);FabulorSemVer=$(FabulorSemVer)" />
  </Target>

</Project>
