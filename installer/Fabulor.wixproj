<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="WixToolset.Sdk/7.0.0">

  <PropertyGroup>
    <Platform>x64</Platform>
    <AcceptEula>wix7</AcceptEula>

    <WixToolsetMajorVersion>7</WixToolsetMajorVersion>
    <WixToolsetVersion>7.0.0</WixToolsetVersion>
    <FabulorPayloadRoot Condition="'$(FabulorPayloadRoot)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\zoitechat-build\$(Platform)\rel\'))</FabulorPayloadRoot>
    <GtkRuntimeRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Runtime\GTK4\'))</GtkRuntimeRoot>
    <ManagedPluginHostRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\src\managed\Fabulor.PluginHost\bin\$(Platform)\$(Configuration)\net8.0\'))</ManagedPluginHostRoot>
    <BundledDotNetRoot Condition="'$(BundledDotNetRoot)'=='' and '$(DOTNET_ROOT)'!=''">$(DOTNET_ROOT)</BundledDotNetRoot>
    <BundledDotNetRoot Condition="'$(BundledDotNetRoot)'==''">C:\Program Files\dotnet</BundledDotNetRoot>
    <BundledDotNetHostFxrRoot>$([System.IO.Path]::GetFullPath('$(BundledDotNetRoot)\host\fxr\'))</BundledDotNetHostFxrRoot>
    <BundledDotNetSharedRuntimeRoot>$([System.IO.Path]::GetFullPath('$(BundledDotNetRoot)\shared\Microsoft.NETCore.App\'))</BundledDotNetSharedRuntimeRoot>
    <BundledDotNetRuntimeVersion Condition="'$(BundledDotNetRuntimeVersion)'==''">8.0.28</BundledDotNetRuntimeVersion>
    <PythonRuntimeRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Runtime\Python314\'))</PythonRuntimeRoot>
    <PythonRuntimeDll>python314.dll</PythonRuntimeDll>
    <PythonRuntimeFolderName>Python314</PythonRuntimeFolderName>
    <TclRuntimeRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Runtime\Tcl\'))</TclRuntimeRoot>
    <DefineConstants>$(DefineConstants);FabulorSemVer=$(FabulorSemVer);FabulorPayloadRoot=$(FabulorPayloadRoot);GtkRuntimeRoot=$(GtkRuntimeRoot);ManagedPluginHostRoot=$(ManagedPluginHostRoot);BundledDotNetRoot=$(BundledDotNetRoot);BundledDotNetHostFxrRoot=$(BundledDotNetHostFxrRoot);BundledDotNetSharedRuntimeRoot=$(BundledDotNetSharedRuntimeRoot);BundledDotNetRuntimeVersion=$(BundledDotNetRuntimeVersion);PythonRuntimeRoot=$(PythonRuntimeRoot);PythonRuntimeFolderName=$(PythonRuntimeFolderName);TclRuntimeRoot=$(TclRuntimeRoot)</DefineConstants>

    <WixProjectType>Package</WixProjectType>
    <OutputName>Fabulor</OutputName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SuppressIces>ICE60</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Product.wxs" />
    <Compile Include="Components\**\*.wxs" />
  </ItemGroup>

  <Target Name="BuildManagedPluginHost" BeforeTargets="Compile">
    <MSBuild Projects="..\src\managed\Fabulor.PluginHost\Fabulor.PluginHost.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform)" />
  </Target>

  <Target Name="ValidateInstallerPayload" BeforeTargets="Build" DependsOnTargets="BuildManagedPluginHost">
    <Error Condition="!Exists('$(FabulorPayloadRoot)\fabulor.exe')" Text="Missing built Fabulor payload at $(FabulorPayloadRoot). Build win32\zoitechat.sln first so fabulor.exe and the staged rel payload exist." />
    <Error Condition="!Exists('$(FabulorPayloadRoot)\libenchant-2-2.dll')" Text="Missing MSVC Enchant 2 core at $(FabulorPayloadRoot)\libenchant-2-2.dll. Run tools\build-enchant-msvc.ps1 before packaging." />
    <Error Condition="!Exists('$(FabulorPayloadRoot)\lib\enchant-2\enchant_winspell.dll')" Text="Missing MSVC WinSpell provider under $(FabulorPayloadRoot)\lib\enchant-2. Run tools\build-enchant-msvc.ps1 before packaging." />
    <Error Condition="!Exists('$(FabulorPayloadRoot)\share\enchant-2\enchant.ordering')" Text="Missing Enchant 2 provider ordering under $(FabulorPayloadRoot)\share\enchant-2. Run tools\build-enchant-msvc.ps1 before packaging." />
    <Error Condition="!Exists('$(FabulorPayloadRoot)\plugins')" Text="Missing plugin payload at $(FabulorPayloadRoot)\plugins. Build win32\zoitechat.sln first so the staged rel payload exists." />
    <Error Condition="!Exists('$(GtkRuntimeRoot)\bin\gtk-4-1.dll')" Text="Missing GTK4 runtime payload at $(GtkRuntimeRoot)." />
    <Error Condition="!Exists('$(ManagedPluginHostRoot)\Fabulor.PluginHost.runtimeconfig.json')" Text="Missing managed plugin host payload at $(ManagedPluginHostRoot)." />
    <Error Condition="!Exists('$(BundledDotNetRoot)\host\fxr')" Text="Missing .NET hostfxr root at $(BundledDotNetRoot)." />
    <Error Condition="!Exists('$(BundledDotNetRoot)\shared\Microsoft.NETCore.App')" Text="Missing .NET shared runtime payload under $(BundledDotNetRoot)\shared\Microsoft.NETCore.App." />
    <Error Condition="!Exists('$(PythonRuntimeRoot)\$(PythonRuntimeDll)')" Text="Missing Python 3.14 runtime payload at $(PythonRuntimeRoot)." />
    <Error Condition="!Exists('$(FabulorPayloadRoot)\plugins\hcpython3.dll')" Text="Missing Python plugin host at $(FabulorPayloadRoot)\plugins\hcpython3.dll. Build plugins\python\python3.vcxproj first." />
    <Error Condition="!Exists('$(FabulorPayloadRoot)\python\zoitechat.py')" Text="Missing staged Python API modules at $(FabulorPayloadRoot)\python. Build win32\copy\copy.vcxproj first." />
    <Error Condition="$([System.IO.Directory]::GetFiles('$(FabulorPayloadRoot)', '_cffi_backend.*.pyd').Length) == 0" Text="Missing staged Python CFFI backend under $(FabulorPayloadRoot). Build win32\copy\copy.vcxproj first." />
    <Error Condition="!Exists('$(TclRuntimeRoot)\bin\tcl86t.dll')" Text="Missing Tcl runtime payload at $(TclRuntimeRoot)." />
  </Target>

  <Target Name="BuildBootstrapper" AfterTargets="Build">
    <MSBuild Projects="Bootstrapper\FabulorSetup.wixproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform);FabulorSemVer=$(FabulorSemVer)" />
  </Target>

</Project>
