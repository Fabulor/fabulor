<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <Property Id="FABULOR_SETUP_BUNDLE" Secure="yes" />
    <Property Id="FABULOR_SETUP_PROVIDER">
      <RegistrySearch Id="SetupProviderSearch" Root="HKLM" Bitness="always64"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[FABULOR_SETUP_BUNDLE]"
                      Name="BundleProviderKey" Type="raw" />
    </Property>
    <Property Id="FABULOR_SETUP_TAG">
      <RegistrySearch Id="SetupTagSearch" Root="HKLM" Bitness="always64"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[FABULOR_SETUP_BUNDLE]"
                      Name="BundleTag" Type="raw" />
    </Property>
    <Property Id="FABULOR_PREVIOUS_SETUP_BUNDLE">
      <RegistrySearch Id="PreviousSetupBundleSearch" Root="HKLM" Bitness="always64"
                      Key="Software\Fabulor\Installer\SetupOwner"
                      Name="BundleCode" Type="raw" />
    </Property>
    <Property Id="FABULOR_PREVIOUS_SETUP_PRODUCT">
      <RegistrySearch Id="PreviousSetupProductSearch" Root="HKLM" Bitness="always64"
                      Key="Software\Fabulor\Installer\SetupOwner"
                      Name="ProductCode" Type="raw" />
    </Property>
    <!-- Clear caller-supplied search results before reading the machine registry. -->
    <InstallUISequence>
      <AppSearch Suppress="yes" />
    </InstallUISequence>
    <SetProperty Id="FABULOR_SETUP_PROVIDER" Value="[FabulorUnsetSetupProperty]"
                 Before="AppSearch" Sequence="execute" />
    <SetProperty Id="FABULOR_SETUP_TAG" Value="[FabulorUnsetSetupProperty]"
                 Before="AppSearch" Sequence="execute" />
    <SetProperty Id="FABULOR_PREVIOUS_SETUP_BUNDLE" Value="[FabulorUnsetSetupProperty]"
                 Before="AppSearch" Sequence="execute" />
    <SetProperty Id="FABULOR_PREVIOUS_SETUP_PRODUCT" Value="[FabulorUnsetSetupProperty]"
                 Before="AppSearch" Sequence="execute" />
    <SetProperty Id="FABULOR_SETUP_BUNDLE" Value="[FABULOR_PREVIOUS_SETUP_BUNDLE]"
                 After="AppSearch" Sequence="execute"
                 Condition="Installed AND NOT FABULOR_SETUP_BUNDLE AND FABULOR_PREVIOUS_SETUP_PRODUCT ~= ProductCode" />
    <SetProperty Id="FabulorRemovableSetupBundle" Value="[FABULOR_PREVIOUS_SETUP_BUNDLE]"
                 After="AppSearch" Sequence="execute"
                 Condition='(FABULOR_PREVIOUS_SETUP_BUNDLE &lt;&lt; "{") AND (FABULOR_PREVIOUS_SETUP_BUNDLE &gt;&gt; "}") AND NOT (FABULOR_PREVIOUS_SETUP_BUNDLE &gt;&lt; "\") AND NOT (FABULOR_PREVIOUS_SETUP_BUNDLE ~= FABULOR_SETUP_BUNDLE)' />

    <!-- Published bundles can be left behind when the MSI owns the upgrade
         and Burn suppresses the older bundle's separate uninstall.
         These releases predate the Setup ownership record. -->
    <Property Id="FABULOR_PUBLISHED_107_BUNDLE_PROVIDER" Secure="yes">
      <RegistrySearch Id="Published107BundleProviderSearch"
                      Root="HKLM"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{656AE58B-7162-48D0-8895-D091BC63C9F8}"
                      Name="BundleProviderKey"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Property Id="FABULOR_PUBLISHED_108_BUNDLE_PROVIDER" Secure="yes">
      <RegistrySearch Id="Published108BundleProviderSearch"
                      Root="HKLM"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{024C5249-B7B6-46D3-A28A-2988A70FA132}"
                      Name="BundleProviderKey"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Property Id="FABULOR_PUBLISHED_109_BUNDLE_PROVIDER" Secure="yes">
      <RegistrySearch Id="Published109BundleProviderSearch"
                      Root="HKLM"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{A14F00B5-E3CD-4B52-B7CE-5AB6E125841D}"
                      Name="BundleProviderKey"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Property Id="IRC_PROTOCOL_HANDLER">
      <RegistrySearch Id="IrcProtocolHandlerSearch"
                      Root="HKLM"
                      Key="Software\Classes\irc\shell\open\command"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Property Id="IRCS_PROTOCOL_HANDLER">
      <RegistrySearch Id="IrcsProtocolHandlerSearch"
                      Root="HKLM"
                      Key="Software\Classes\ircs\shell\open\command"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <ComponentGroup Id="InstalledModeCoreComponents">
      <!-- Bind the Setup registration to the exact MSI product that owns it. -->
      <Component Id="TrackSetupOwner" Guid="CA5CE992-C45A-47E8-87E8-4EC6599CB33E"
                 Directory="INSTALLFOLDER" Bitness="always64"
                 Condition='NOT FABULOR_PORTABLE AND FABULOR_SETUP_BUNDLE AND (FABULOR_SETUP_BUNDLE &lt;&lt; "{") AND (FABULOR_SETUP_BUNDLE &gt;&gt; "}") AND NOT (FABULOR_SETUP_BUNDLE &gt;&lt; "\") AND FABULOR_SETUP_PROVIDER ~= FABULOR_SETUP_BUNDLE AND FABULOR_SETUP_TAG = "Fabulor.Setup.Owner"'>
        <RegistryValue Root="HKLM" Key="Software\Fabulor\Installer\SetupOwner"
                       Name="BundleCode" Type="string" Value="[FABULOR_SETUP_BUNDLE]" />
        <RegistryValue Root="HKLM" Key="Software\Fabulor\Installer\SetupOwner"
                       Name="ProductCode" Type="string" Value="[ProductCode]" KeyPath="yes" />
      </Component>
      <Component Id="RemovePreviousSetupEntry" Guid="6F64E511-8965-47F0-88D5-88978E887CCF"
                 Directory="INSTALLFOLDER" Bitness="always64"
                 Condition='NOT FABULOR_PORTABLE AND NOT Installed AND FabulorRemovableSetupBundle AND FABULOR_PREVIOUS_SETUP_PRODUCT AND (WIX_UPGRADE_DETECTED &gt;&lt; FABULOR_PREVIOUS_SETUP_PRODUCT)'>
        <RemoveRegistryKey Id="RemovePreviousBundleRegistration"
                           Root="HKLM"
                           Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[FabulorRemovableSetupBundle]"
                           Action="removeOnInstall" />
        <RegistryValue Root="HKLM" Key="Software\Fabulor\Installer"
                       Name="RemovedPreviousSetupEntry" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="RemovePublished107SetupEntry" Guid="3857A576-E60F-4F04-99A0-41CBCFEF06E0"
                 Directory="INSTALLFOLDER" Bitness="always64"
                 Condition='NOT FABULOR_PORTABLE AND NOT Installed AND (WIX_UPGRADE_DETECTED &gt;&lt; "{504E5953-1796-4142-AB4C-71A159FA4853}") AND FABULOR_PUBLISHED_107_BUNDLE_PROVIDER = "{656AE58B-7162-48D0-8895-D091BC63C9F8}"'>
        <RemoveRegistryKey Id="RemovePublished107BundleRegistration"
                           Root="HKLM"
                           Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{656AE58B-7162-48D0-8895-D091BC63C9F8}"
                           Action="removeOnInstall" />
        <RegistryValue Root="HKLM"
                       Key="Software\Fabulor\Installer"
                       Name="RemovedPublished107SetupEntry"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
      <Component Id="RemovePublished108SetupEntry" Guid="9D5296EF-7828-494F-A511-AE1F39903E16"
                 Directory="INSTALLFOLDER" Bitness="always64"
                 Condition='NOT FABULOR_PORTABLE AND NOT Installed AND (WIX_UPGRADE_DETECTED &gt;&lt; "{29CFD3A2-ED65-4D20-9DC8-5FFB84A715FD}") AND FABULOR_PUBLISHED_108_BUNDLE_PROVIDER = "{024C5249-B7B6-46D3-A28A-2988A70FA132}"'>
        <RemoveRegistryKey Id="RemovePublished108BundleRegistration"
                           Root="HKLM"
                           Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{024C5249-B7B6-46D3-A28A-2988A70FA132}"
                           Action="removeOnInstall" />
        <RegistryValue Root="HKLM"
                       Key="Software\Fabulor\Installer"
                       Name="RemovedPublished108SetupEntry"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
      <Component Id="RemovePublished109SetupEntry" Guid="6C3BDC17-4624-42F7-A619-9767BFB4ABD8"
                 Directory="INSTALLFOLDER" Bitness="always64"
                 Condition='NOT FABULOR_PORTABLE AND NOT Installed AND (WIX_UPGRADE_DETECTED &gt;&lt; "{4FA55D87-8925-4718-9956-6FACD1DBB9B3}") AND FABULOR_PUBLISHED_109_BUNDLE_PROVIDER = "{A14F00B5-E3CD-4B52-B7CE-5AB6E125841D}"'>
        <RemoveRegistryKey Id="RemovePublished109BundleRegistration"
                           Root="HKLM"
                           Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{A14F00B5-E3CD-4B52-B7CE-5AB6E125841D}"
                           Action="removeOnInstall" />
        <RegistryValue Root="HKLM"
                       Key="Software\Fabulor\Installer"
                       Name="RemovedPublished109SetupEntry"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
      <Component Id="InstalledModeCleanup" Guid="0A54F269-9BDB-4D60-9FD7-E5F9D4B6A1E8" Directory="INSTALLFOLDER" Condition="NOT FABULOR_PORTABLE">
        <RemoveFile Id="RemoveInstalledStartMenuShortcut"
                    Directory="ApplicationProgramsFolder"
                    Name="Fabulor.lnk"
                    On="uninstall" />
        <RemoveFile Id="RemoveInstalledSafeModeStartMenuShortcut"
                    Directory="ApplicationProgramsFolder"
                    Name="Fabulor Safe Mode.lnk"
                    On="uninstall" />
        <RemoveFolder Id="RemoveInstalledConfigFolder" Directory="CONFIGDIR" On="uninstall" />
        <RemoveFolder Id="RemoveInstalledDotNetFolder" Directory="DOTNETDIR" On="uninstall" />
        <RemoveFolder Id="RemoveInstalledRuntimeFolder" Directory="RUNTIMEDIR" On="uninstall" />
        <RemoveFolder Id="RemoveInstalledProgramMenuFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RemoveFolder Id="RemoveInstalledInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RegistryValue Root="HKLM"
                       Key="Software\Fabulor\Installer"
                       Name="InstalledModeCleanup"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="StartMenuComponents">
      <Component Id="StartMenuShortcuts" Guid="F43D5E14-9D5A-4F9D-8E44-4B45F2F8D211" Directory="ApplicationProgramsFolder" Condition="NOT FABULOR_PORTABLE">
        <Shortcut Id="FabulorStartMenuShortcut"
                  Name="Fabulor"
                  Target="[INSTALLFOLDER]fabulor.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="FabulorSafeModeStartMenuShortcut"
                  Name="Fabulor Safe Mode"
                  Target="[INSTALLFOLDER]fabulor.exe"
                  Arguments="--no-auto --no-plugins"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveFabulorProgramMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Fabulor\Installer"
                       Name="StartMenuShortcuts"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="DesktopShortcutComponents">
      <Component Id="DesktopShortcut" Guid="A4738A07-DB0F-40B4-88DE-242C2DEF653E" Directory="DesktopFolder" Condition="NOT FABULOR_PORTABLE">
        <Shortcut Id="FabulorDesktopShortcut"
                  Name="Fabulor"
                  Target="[INSTALLFOLDER]fabulor.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\Fabulor\Installer"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ShellIntegrationComponents">
      <Component Id="IrcProtocolRegistrationV2" Guid="67349AC3-5818-4F78-BE4A-A4B117632238" Directory="INSTALLFOLDER" Condition="NOT FABULOR_PORTABLE">
        <RegistryKey Root="HKLM" Key="Software\Classes\Fabulor.Url.Irc">
          <RegistryValue Type="string" Value="Fabulor IRC URL" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\Fabulor.Url.Irc\DefaultIcon">
          <RegistryValue Type="string" Value="[INSTALLFOLDER]fabulor.exe,0" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\Fabulor.Url.Irc\shell">
          <RegistryValue Type="string" Value="open" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\Fabulor.Url.Irc\shell\open\command">
          <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]fabulor.exe&quot; --url=&quot;%1&quot;" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\Fabulor.Url.IrcSecure">
          <RegistryValue Type="string" Value="Fabulor secure IRC URL" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\Fabulor.Url.IrcSecure\DefaultIcon">
          <RegistryValue Type="string" Value="[INSTALLFOLDER]fabulor.exe,0" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\Fabulor.Url.IrcSecure\shell">
          <RegistryValue Type="string" Value="open" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\Fabulor.Url.IrcSecure\shell\open\command">
          <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]fabulor.exe&quot; --url=&quot;%1&quot;" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Fabulor\Capabilities">
          <RegistryValue Name="ApplicationName" Type="string" Value="Fabulor" />
          <RegistryValue Name="ApplicationDescription" Type="string" Value="Fabulor IRC client" />
          <RegistryValue Name="ApplicationIcon" Type="string" Value="[INSTALLFOLDER]fabulor.exe,0" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Fabulor\Capabilities\UrlAssociations">
          <RegistryValue Name="irc" Type="string" Value="Fabulor.Url.Irc" />
          <RegistryValue Name="ircs" Type="string" Value="Fabulor.Url.IrcSecure" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Fabulor\Capabilities\FileAssociations">
          <RegistryValue Name=".hct" Type="string" Value="Fabulor.Theme" />
        </RegistryKey>
        <RegistryValue Root="HKLM"
                       Key="Software\RegisteredApplications"
                       Name="Fabulor"
                       Type="string"
                       Value="Software\Fabulor\Capabilities" />
        <RegistryValue Root="HKLM"
                       Key="Software\Fabulor\Installer"
                       Name="IrcProtocol"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
      <Component Id="IrcProtocolFallbackRegistration" Guid="8236D81C-95C7-4C85-A99D-22E5EF6895D5" Directory="INSTALLFOLDER" Condition="NOT FABULOR_PORTABLE AND (NOT IRC_PROTOCOL_HANDLER OR IRC_PROTOCOL_HANDLER ~&gt;&lt; &quot;fabulor.exe&quot;)" NeverOverwrite="yes">
        <RegistryKey Root="HKLM" Key="Software\Classes\irc">
          <RegistryValue Type="string" Value="URL:IRC Protocol" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" KeyPath="yes" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\irc\DefaultIcon">
          <RegistryValue Type="string" Value="[INSTALLFOLDER]fabulor.exe,0" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\irc\shell">
          <RegistryValue Type="string" Value="open" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\irc\shell\open\command">
          <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]fabulor.exe&quot; --url=&quot;%1&quot;" />
        </RegistryKey>
      </Component>
      <Component Id="IrcsProtocolFallbackRegistration" Guid="12CD8341-88B1-467E-BFC2-265473D98432" Directory="INSTALLFOLDER" Condition="NOT FABULOR_PORTABLE AND (NOT IRCS_PROTOCOL_HANDLER OR IRCS_PROTOCOL_HANDLER ~&gt;&lt; &quot;fabulor.exe&quot;)" NeverOverwrite="yes">
        <RegistryKey Root="HKLM" Key="Software\Classes\ircs">
          <RegistryValue Type="string" Value="URL:IRCS Protocol" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" KeyPath="yes" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\ircs\DefaultIcon">
          <RegistryValue Type="string" Value="[INSTALLFOLDER]fabulor.exe,0" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\ircs\shell">
          <RegistryValue Type="string" Value="open" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\ircs\shell\open\command">
          <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]fabulor.exe&quot; --url=&quot;%1&quot;" />
        </RegistryKey>
      </Component>
      <Component Id="ThemeAssociationRegistration" Guid="C4B1CE84-9B3D-4A8F-A44A-FB0CEB45D3A6" Directory="INSTALLFOLDER" Condition="NOT FABULOR_PORTABLE">
        <RegistryKey Root="HKLM" Key="Software\Classes\.hct">
          <RegistryValue Type="string" Value="Fabulor.Theme" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\Fabulor.Theme">
          <RegistryValue Type="string" Value="Fabulor Theme" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\Fabulor.Theme\DefaultIcon">
          <RegistryValue Type="string" Value="[INSTALLFOLDER]fabulor.exe,0" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\Fabulor.Theme\shell\open\command">
          <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]fabulor.exe&quot; &quot;%1&quot;" />
        </RegistryKey>
        <RegistryValue Root="HKLM"
                       Key="Software\Fabulor\Installer"
                       Name="ThemeAssociation"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
