<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="ThemeAssetComponents">
      <Component Id="AdwaitaIconsAttributionAsset" Guid="E4038AE8-C71C-440D-9876-61A6B7FA6D28" Directory="SHAREDIR">
        <File Id="AdwaitaIconsAttributionAssetFile"
              Source="$(sys.SOURCEFILEDIR)..\..\data\icons\adwaita\ATTRIBUTION.txt"
              Name="adwaita-icons-attribution.txt"
              KeyPath="yes" />
      </Component>
      <Component Id="GtkPreferencesAsset" Guid="38C556BA-83A0-4522-996A-7506510B2DE7" Directory="SHAREDIR">
        <File Id="GtkPreferencesAssetFile"
              Source="$(sys.SOURCEFILEDIR)..\..\data\icons\gtkpref.png"
              Name="gtkpref.png"
              KeyPath="yes" />
      </Component>
      <Component Id="FabulorDarkPaletteAsset" Guid="476CD7A0-8C01-41FA-8485-161CA4015289" Directory="SHAREPALETTEDIR">
        <File Id="FabulorDarkPaletteAssetFile"
              Source="$(sys.SOURCEFILEDIR)..\..\data\palettes\Fabulor Dark.hct"
              Name="Fabulor Dark.hct"
              KeyPath="yes" />
      </Component>
      <Component Id="Hicolor48AppIconAsset" Guid="8A7D631A-D735-4A93-9A7A-85A1D9DB0FD4" Directory="HICOLOR48APPDIR">
        <File Id="Hicolor48AppIconAssetFile"
              Source="$(sys.SOURCEFILEDIR)..\..\data\icons\fabulor.png"
              Name="net.fabulor.Fabulor.png"
              KeyPath="yes" />
      </Component>
      <Component Id="HicolorScalableAppIconAsset" Guid="0635F58A-B084-4B5B-B43F-553A67A896A0" Directory="HICOLORSCALABLEAPPDIR">
        <File Id="HicolorScalableAppIconAssetFile"
              Source="$(sys.SOURCEFILEDIR)..\..\data\icons\Fabulor.svg"
              Name="net.fabulor.Fabulor.svg"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="AdwaitaIconThemeComponents" Directory="ADWAITACATEGORYDIR">
      <Component Id="AdwaitaEmojiIndexThemeAsset" Guid="AF29006A-6D5E-4AE5-A8D8-BD06CB6F7C8F" Directory="ADWAITADIR">
        <File Id="AdwaitaEmojiIndexThemeAssetFile"
              Source="$(sys.SOURCEFILEDIR)..\..\data\icons\adwaita\index.theme"
              Name="index.theme"
              KeyPath="yes" />
      </Component>
      <Files Include="$(sys.SOURCEFILEDIR)..\..\data\icons\adwaita\symbolic\categories\**" />
    </ComponentGroup>

    <ComponentGroup Id="CommonShareAssetComponents">
      <Component Id="MusicAsset" Guid="35584C2B-7E79-4AB7-8B87-76D44099D4A3" Directory="SHAREDIR">
        <File Id="MusicAssetFile"
              Source="$(sys.SOURCEFILEDIR)..\..\data\icons\music.png"
              Name="music.png"
              KeyPath="yes" />
      </Component>
      <Component Id="Iso3166Asset" Guid="FCF4030A-540D-4C70-BAA0-39DD5798103F" Directory="SHAREISOCODESDIR">
        <File Id="Iso3166AssetFile"
              Source="$(sys.SOURCEFILEDIR)..\..\data\iso-codes\iso_3166.xml"
              Name="iso_3166.xml"
              KeyPath="yes" />
      </Component>
      <Component Id="Iso639Asset" Guid="3CCC5C5B-EACC-4D37-ACF8-E44021E1DFB4" Directory="SHAREISOCODESDIR">
        <File Id="Iso639AssetFile"
              Source="$(sys.SOURCEFILEDIR)..\..\data\iso-codes\iso_639.xml"
              Name="iso_639.xml"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="SysinfoPluginShareAssetComponents">
      <Component Id="SysinfoShareAsset" Guid="4B7E7A99-3F13-4D81-90C3-3495A93A1D75" Directory="SHAREDIR">
        <File Id="SysinfoShareAssetFile"
              Source="$(sys.SOURCEFILEDIR)..\..\data\icons\system.png"
              Name="system.png"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

  </Fragment>
</Wix>
