<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="PluginFolderComponents" Directory="PLUGINDIR">
      <Component Id="PluginFolder" Guid="20A45D6C-77FD-4A2D-9EE1-74DE10B396AF" Directory="PLUGINDIR">
        <CreateFolder />
        <RemoveFolder Id="RemovePluginFolder" On="uninstall" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="PluginBaseComponents" Directory="PLUGINDIR">
      <Files Include="$(var.Gtk4FrontendRoot)\plugins\hcnotifications-winrt.dll" />
    </ComponentGroup>

    <ComponentGroup Id="ChecksumPluginComponents" Directory="PLUGINDIR">
      <Files Include="$(var.Gtk4FrontendRoot)\plugins\hcchecksum.dll" />
    </ComponentGroup>

    <ComponentGroup Id="ExecPluginComponents" Directory="PLUGINDIR">
      <Files Include="$(var.Gtk4FrontendRoot)\plugins\hcexec.dll" />
    </ComponentGroup>

    <ComponentGroup Id="FishlimPluginComponents" Directory="PLUGINDIR">
      <Files Include="$(var.Gtk4FrontendRoot)\plugins\hcfishlim.dll" />
    </ComponentGroup>

    <ComponentGroup Id="PythonHostComponents" Directory="PLUGINDIR">
      <Files Include="$(var.Gtk4FrontendRoot)\plugins\hcpython3.dll" />
    </ComponentGroup>

    <ComponentGroup Id="PythonApiComponents" Directory="PYTHONAPIDIR">
      <Files Include="$(var.Gtk4PluginHostRoot)\python\**" />
    </ComponentGroup>

    <ComponentGroup Id="SysinfoPluginComponents" Directory="PLUGINDIR">
      <Files Include="$(var.Gtk4FrontendRoot)\plugins\hcsysinfo.dll" />
    </ComponentGroup>

  </Fragment>
</Wix>
