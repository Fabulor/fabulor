<Window x:Class="Fabulor.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fabulor Setup"
        Icon="Assets/fabulor.ico"
        Width="720"
        Height="620"
        MinWidth="600"
        MinHeight="500"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220"
        KeyboardNavigation.TabNavigation="Cycle">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#111827" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="BorderBrush" Color="#334155" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FBBF24" />
        <SolidColorBrush x:Key="TextBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#CBD5E1" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,5,0,5" />
            <Setter Property="AutomationProperties.HelpText" Value="Select or clear this option." />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="9,6" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="94" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.80" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#D19A16" />
            <Setter Property="Foreground" Value="#111827" />
        </Style>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#020617" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/fabulor-about.png"
                       Width="72"
                       Height="72"
                       Stretch="Uniform"
                       AutomationProperties.Name="Fabulor logo" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontSize="25" FontWeight="SemiBold" Text="Fabulor Setup" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="Install or maintain Fabulor and choose how it integrates with Windows." />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="18,14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border x:Name="StatePanel" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="StateHeadingTextBlock" FontSize="20" FontWeight="SemiBold" Text="Ready to install" />
                        <TextBlock x:Name="StateDescriptionTextBlock"
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Fabulor is not currently installed. Review the location below, then select Install." />
                    </StackPanel>
                </Border>

                <Border x:Name="ConfigurationPanel" Margin="0,12,0,0" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="ConfigurationHeadingTextBlock"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="Installation" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="Install folder:" />
                            <TextBox x:Name="InstallFolderTextBox"
                                     Grid.Column="1"
                                     AutomationProperties.Name="Install folder"
                                     TextChanged="InstallFolderTextBox_OnTextChanged" />
                            <Button x:Name="BrowseInstallFolderButton"
                                    Grid.Column="2"
                                    Style="{StaticResource ButtonStyle}"
                                    Click="BrowseInstallFolderButton_OnClick"
                                    Content="_Browse..." />
                        </Grid>

                        <StackPanel Margin="0,10,0,0">
                            <CheckBox x:Name="StartMenuShortcutsCheckBox" Content="_Start Menu shortcuts" />
                            <CheckBox x:Name="DesktopShortcutCheckBox" Content="_Desktop shortcut" />
                            <CheckBox x:Name="ShellIntegrationCheckBox" Content="IRC links and _theme file associations" />
                        </StackPanel>

                        <Expander x:Name="AdvancedOptionsExpander"
                                  Margin="0,10,0,0"
                                  Header="_Advanced options"
                                  AutomationProperties.Name="Advanced installation options">
                            <StackPanel Margin="18,10,0,0">
                                <CheckBox x:Name="PortableModeCheckBox"
                                          Checked="PortableModeCheckBox_OnChanged"
                                          Unchecked="PortableModeCheckBox_OnChanged"
                                          Content="_Portable mode" />
                                <TextBlock x:Name="ModeSummaryTextBlock"
                                           Margin="0,2,0,10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,4,0,3" FontWeight="SemiBold" Text="Plugin runtimes" />
                                <CheckBox x:Name="DotNetPluginHostCheckBox" Content="_C# plugin host and .NET runtime" />
                                <CheckBox x:Name="PythonRuntimeCheckBox" Content="_Python plugin runtime (3.14)" />
                                <CheckBox x:Name="TclRuntimeCheckBox" Content="_Tcl plugin runtime (8.6)" />

                                <TextBlock Margin="0,10,0,3" FontWeight="SemiBold" Text="Optional components" />
                                <CheckBox x:Name="TranslationsCheckBox" Content="Translations" />
                                <CheckBox x:Name="ChecksumPluginCheckBox" Content="Checksum plugin" />
                                <CheckBox x:Name="ExecPluginCheckBox" Content="Exec plugin" />
                                <CheckBox x:Name="FishlimPluginCheckBox" Content="FiSHLiM plugin" />
                                <CheckBox x:Name="SysinfoPluginCheckBox" Content="SysInfo plugin" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border x:Name="CompletionPanel"
                        Margin="0,12,0,0"
                        Style="{StaticResource SectionBorderStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Setup complete" />
                        <TextBlock x:Name="CompletionTextBlock"
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Fabulor is ready to use." />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="StatusTextBlock"
                                   Text="Initialising setup..."
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar x:Name="ProgressBar"
                                     Margin="0,10,0,0"
                                     Height="16"
                                     Minimum="0"
                                     Maximum="100"
                                     AutomationProperties.Name="Setup progress" />

                        <Expander x:Name="DetailsExpander"
                                  Margin="0,10,0,0"
                                  Header="Show _details"
                                  AutomationProperties.Name="Setup details">
                            <StackPanel Margin="0,8,0,0">
                                <TextBox x:Name="LogTextBox"
                                         MinHeight="105"
                                         MaxHeight="180"
                                         Background="#020617"
                                         FontFamily="Consolas"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         AcceptsReturn="True"
                                         AutomationProperties.Name="Installer session log" />
                                <StackPanel Margin="0,8,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource ButtonStyle}"
                                            Click="OpenLogFolderButton_OnClick"
                                            Content="Open _log folder" />
                                    <Button x:Name="CopyErrorDetailsButton"
                                            Style="{StaticResource ButtonStyle}"
                                            Click="CopyErrorDetailsButton_OnClick"
                                            Content="_Copy error details"
                                            IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14">
            <Grid>
                <Button x:Name="LicenceButton"
                        HorizontalAlignment="Left"
                        Style="{StaticResource ButtonStyle}"
                        Margin="0"
                        Click="LicenceButton_OnClick"
                        Content="_Licence" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="InstallButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="InstallButton_OnClick"
                            Content="_Install" />
                    <Button x:Name="RepairButton"
                            Style="{StaticResource ButtonStyle}"
                            Click="RepairButton_OnClick"
                            Content="_Repair"
                            Visibility="Collapsed" />
                    <Button x:Name="UninstallButton"
                            Style="{StaticResource ButtonStyle}"
                            Background="#9A3412"
                            BorderBrush="#7C2D12"
                            Click="UninstallButton_OnClick"
                            Content="_Uninstall"
                            Visibility="Collapsed" />
                    <Button x:Name="LaunchButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="LaunchButton_OnClick"
                            Content="_Launch Fabulor"
                            Visibility="Collapsed" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource ButtonStyle}"
                            Click="CloseButton_OnClick"
                            Content="_Close" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
